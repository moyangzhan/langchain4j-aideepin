<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyz.adi.common.mapper.KnowledgeBaseMessageRefGraphMapper">
    <select id="listByChatUuid" resultType="com.moyz.adi.common.entity.KnowledgeBaseMessageRefGraph">
        select *
        from adi_knowledge_base_message_ref_graph a
                 inner join adi_knowledge_base_message b on a.message_id = b.id
        where b.uuid = #{chatUuid}
    </select>

</mapper>
