<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyz.adi.common.mapper.CharacterMemorySemanticMapper">

    <!--
      Merge UPDATE path: content upsert keyed on the memory uuid. The insert branch
      covers transition-window rows whose relational row is not backfilled yet; the
      conflict branch is the steady state (row exists, content merges) and revives
      a soft-deleted row so an UPDATE following a DELETE in the same batch keeps
      the memory alive. word_count is a generated column and
      hit_count/create_time/update_time take their defaults on insert.
      <p>
      合并 UPDATE 路径：按记忆 uuid upsert 内容。插入分支覆盖回填窗口期尚无关系行的存量向量行；
      冲突分支为稳态（行已存在、内容合并），并把软删行复活——同批先 DELETE 后 UPDATE 时记忆
      保持存活（后写胜出）。
    -->
    <insert id="upsertContent">
        insert into adi_character_memory_semantic (uuid, character_id, content, user_id)
        values (#{uuid}, #{characterId}, #{content}, #{userId})
        on conflict (uuid) do update set content = excluded.content, is_deleted = false
    </insert>

    <update id="incrementHitCountByUuids">
        update adi_character_memory_semantic
        set hit_count = hit_count + 1
        where is_deleted = false
          and uuid in
        <foreach collection="uuids" open="(" separator="," close=")" item="uuid">#{uuid}</foreach>
    </update>
</mapper>
