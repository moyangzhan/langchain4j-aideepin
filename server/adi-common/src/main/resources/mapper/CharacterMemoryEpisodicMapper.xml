<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyz.adi.common.mapper.CharacterMemoryEpisodicMapper">

    <update id="incrementHitCountByUuids">
        update adi_character_memory_episodic
        set hit_count = hit_count + 1
        where is_deleted = false
          and uuid in
        <foreach collection="uuids" open="(" separator="," close=")" item="uuid">#{uuid}</foreach>
    </update>
</mapper>
